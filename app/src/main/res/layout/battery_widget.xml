<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:padding="16dp"
    android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V O L T R A" android:textColor="#BCF36B" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#F0F5EC" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9CAB9F" android:textSize="12sp" android:maxLines="1" android:text="Нет данных" />
</LinearLayout>
